# HTTP port used by the NestJS GraphQL server.
PORT=3001

# MongoDB connection URI. Add credentials only in your untracked local .env file.
MONGODB_URI=mongodb://localhost:27017/scorefilm_catalog

# JWKS endpoint exposed by the authentication service for JWT verification.
AUTH_SERVICE_JWKS_URL=http://localhost:8080/.well-known/jwks.json

# TMDB API base URL used by the TMDB client.
TMDB_BASE_URL=https://api.themoviedb.org/3

# TMDB read access token. Obtain this from TMDB and never commit the real value.
TMDB_READ_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token

# Legacy TMDB API key configuration value. Set it only if code using this setting is enabled.
TMDB_API_KEY=replace_with_your_tmdb_api_key
